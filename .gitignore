# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Caches and tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.screenshots/
.DS_Store
*.tsbuildinfo
.pyscn/

# Environment / secrets
.env
# The live config holds the API key; config/nan.yaml.example is the
# committed template.
config/nan.yaml

# Runtime directories (gitignored)
logs/
turns/
cache/
# segv's cache/ is source code, not runtime state
!workspace/services/segv/segv/cache/
# record's derived Fact index (rebuildable from turns/)
builtin/services/record/fact/
snapshots/
# RocksDB renames a store to turns.<reason>-<timestamp>/ when it fails to open.
turns.*/
# segv service runtime state (the RocksDB archive itself)
workspace/services/segv/data/
*.log
*.log.*
workspace/*.pid

# Model weights (large binaries, managed outside git)
models/
infraend/

# research
paper_search/
.memos/

# local-only trees
design/
legacy/
.trae-html-share-packages/

# vision is being rewritten; the ignore goes away with the rewrite
builtin/services/vision/
.nan/
.uv/