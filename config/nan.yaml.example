# Template for the NAN core configuration (nan/ package).
# Copy to config/nan.yaml and fill in the active model. The copy is
# git-ignored: it holds the API key, so it never enters the repository.
#
#   cp config/nan.yaml.example config/nan.yaml
#
# Loaded once into nan.config.settings; environment variables are never read.
# Paths are not configuration: they are code defaults in nan/config (Paths).

llm:
  provider: openai          # "openai" | "anthropic"
  base_url: ""              # empty = provider default endpoint
  api_key: ""               # anything OpenAI-compatible: OpenAI, OpenRouter, llama.cpp...
  model: ""
  max_tokens: 8192          # Anthropic requires it; must exceed thinking_budget
  thinking: true            # capture reasoning and replay it into history
  thinking_budget: 4096     # Anthropic extended-thinking budget; 0 = no native thinking request
  timeout: 120.0
  max_retries: 2
  proxy: ""                 # "": direct (ambient proxies ignored) | "env" | http://host:port

agent:
  autonomous_interval: 0.0  # >0: self-rotating loop (seconds); <=0: event-driven
  history_char_limit: 100000
  shell_timeout: 30.0       # user setting; the model cannot change it
  shell_output_limit: 20000 # shell verb output truncation (head+tail)
  backoff: [1.0, 2.0, 4.0, 8.0, 15.0, 30.0, 60.0]  # turn-failure backoff ladder (s)
  max_depth: 3              # -1: unlimited
  max_children: 5            # -1: unlimited, per agent

sandbox:
  required: true            # true: refuse to start when no sandbox tool exists
  # Command-level deny list, checked before the OS sandbox wraps the
  deny:
    - pattern: '\brm\s+(?:-[^\s]+\s+)*(?:/|~|\$HOME|\$\{HOME\})/?\*?(?=\s|$|[;&|])'
      reason: 'recursive delete of the root or home directory'
    - pattern: '\brm\s+(?:-[^\s]+\s+)*(?:\.|\./|\*|\$PWD|\$\{PWD\}|\$\(pwd\)|`pwd`)(?=\s|$|[;&|])'
      reason: 'recursive delete of the workspace root itself'
    - pattern: '\bdd\b[^;&|\n]*\bof=\s*/dev/(?:r?disk|sd[a-z]|nvme|hd[a-z]|mmcblk)'
      reason: 'writing a raw disk device with dd'
    - pattern: '\b(?:mkfs(?:\.[a-z0-9]+)?|newfs(?:_[a-z0-9]+)?)\b'
      reason: 'formatting a filesystem'
    - pattern: '\b(?:curl|wget)\b[^|;&\n]*\|\s*(?:sudo\s+)?(?:ba|z|k|fi)?sh\b'
      reason: 'piping a download straight into a shell'
    - pattern: '(?:^|[\n;&|]\s*|\b(?:then|do|else)\s+)(?:sudo|doas)\b'
      reason: 'privilege escalation is not available to agent commands'
    - pattern: '([A-Za-z0-9_:.-]+)\s*\(\s*\)\s*\{[^}]*\1[^}]*\|[^}]*\1[^}]*&[^}]*\}\s*;?\s*\1'
      reason: 'fork bomb'

injection:
  host: 127.0.0.1
  port: 8901
  timeout: 2.0              # per-service request timeout
  heartbeat_ttl: 15.0

gateway:
  host: 127.0.0.1
  port: 8765
  surface_ttl: 30.0        # seconds without a panel heartbeat before the window is dropped

autostart:
  enabled: true
