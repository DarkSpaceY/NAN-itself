# Read service configuration. Copy to config.yaml (gitignored) and edit.
#
# A pull-only service: it never registers with the injection hub, so
# `hub_url` is deliberately empty. The agent calls it with a path and a
# request; the answer comes back as one string and never enters its
# history unless the agent writes it down.

service_id: "read"
host: "127.0.0.1"
port: 9006

# One request carries one file. A larger file is refused with
# `too_large`; it is never truncated, because a silently shortened text
# reads as if it were complete.
max_chars: 128000

# Files resolve against this root; empty means NAN_WORKSPACE at boot
# (falling back to the workspace that contains services/read).
workspace: ""

llm:                        # OpenAI-compatible chat completions
  model: "swift-iq3_s"
  base_url: "http://127.0.0.1:8787/v1"
  api_key: "local-placeholder"   # this is why config.yaml is not committed
  temperature: 0.0
  timeout: 900.0            # one long read may outlive the shell window
