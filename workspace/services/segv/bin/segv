#!/usr/bin/env python3
"""segv CLI launcher.

The CLI module is stdlib-only on purpose, so this shim runs on any
python3 — no venv, no uv. Kept next to the package it serves; symlink
or copy it onto PATH (NAN puts <workspace>/bin there automatically).
"""

from __future__ import annotations

import sys
from pathlib import Path

PACKAGE_ROOT = Path(__file__).resolve().parent.parent

sys.path.insert(0, str(PACKAGE_ROOT))

from segv.cli import main  # noqa: E402

raise SystemExit(main())
